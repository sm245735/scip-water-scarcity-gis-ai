# 論文原始大資料不進 Git（重要！）
data/
*.csv
# 但 data/LICENSE 要進 Git（CC BY 4.0 授權聲明）
!data/LICENSE

# 但這些樣本要進 Git（進 Git 展示用）
!data_samples/*.csv
*.xlsx
*.zip

# === 跟論文無關的個人 side project 不進 Git ===
# ICML 2026 翻譯 side project（與本論文研究方向無關）
# 位置：/root/Downloads/ICML2026_papers.xlsx、/tmp/icml_*.py、/tmp/icml2026_*.json
# 規則：即使移到本 repo 內也禁止 commit
/ICML*/
**/ICML2026*

# === 模型輸出（檔案大、會被重新訓練產出，不進 Git）===
# 訓練好的 .keras / .npy / .png 都是輸出產物
# 但 models/*.py 程式碼要進 Git（除非另有安排）
model/
models/*.keras
models/*.h5
models/*.hdf5
models/*.npy
models/*.png
models/*.jpg
models/*.pkl
models/*.joblib
models/*.pt
models/*.pth

# === 草稿檔（手誤/暫存，不進 Git）===
*水庫位置彙整.txt
*草稿*

# Python 垃圾檔
__pycache__/
*.pyc
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Docker
.docker/
.dockerignore

# 虛擬環境
venv/
.venv/

# 環境變數（存資料庫密碼，不能公開）
# === 絕對不能進 Git（防呆用）===
# 任何 .env、密碼檔、金鑰
.env
.env.*
**/.env
**/.env.local
**/secrets.*
**/*.pem
**/id_rsa*
**/id_ed25519*

# === 排程腳本不進 Git（安全考量）===

**/project_health_check.py
**/memory_maintenance.py

# Log 檔（每日收集歷史，不進 Git）
src/logs/
